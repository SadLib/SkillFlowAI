# Copia este archivo a .env en la raíz del monorepo para configurar FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcional. Si se omite, SQLite usa .skillflow/workflows.sqlite3.
SKILLFLOW_DB_PATH=

# Solo en apps/web/.env.local o en Vercel, como URL pública sin /api.
NEXT_PUBLIC_API_URL=http://localhost:8000
